<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      A minimal framework-based window theme. The real look is supplied by the
      Compose RippleTheme; this only styles the window before Compose draws,
      avoiding the default dark-navy system chrome.
    -->
    <style name="Theme.Ripple" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ink</item>
        <item name="android:statusBarColor">@color/ink</item>
        <item name="android:navigationBarColor">@color/ink</item>
    </style>
</resources>
